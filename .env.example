# 실제 값은 .env에 넣습니다. .env는 Git에서 제외됩니다.
# 기본값만으로 local 예시 모드를 실행할 수 있습니다.
SERVER_PORT=18081
PUBLIC_URL=http://127.0.0.1:5173
KAKAO_REST_KEY=
KAKAO_JS_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=20
MAIL_ENABLED=false
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 이 이메일의 소유권을 메일 인증한 뒤 재로그인하면 관리자 권한을 부여합니다.
ADMIN_EMAIL=
# prod 프로필에서만 필수입니다. JDBC URL을 사용합니다.
DATABASE_URL=jdbc:postgresql://localhost:5432/travelpick
DATABASE_USERNAME=travelpick
DATABASE_PASSWORD=
