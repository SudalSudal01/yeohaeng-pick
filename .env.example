# 실제 값은 .env에 넣습니다. .env는 Git에서 제외됩니다.
# 기본값만으로 local 예시 모드를 실행할 수 있습니다.
SERVER_PORT=18081
PUBLIC_URL=http://127.0.0.1:5173
KAKAO_REST_KEY=
KAKAO_JS_KEY=
# 공공데이터포털 국문 관광정보 서비스_GW의 서비스키. 실제 키는 .env에만 입력합니다.
TOUR_API_KEY=
# 단일 실행 서버의 한국 날짜 기준 외부 요청 상한입니다. 공급자 계정 한도와 별도로 관리합니다.
TOUR_API_DAILY_LIMIT=300
GEMINI_API_KEY=
# 신규 프로젝트에서 사용할 수 있는 모델은 공식 모델 목록과 무료 등급 한도에서 다시 확인합니다.
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DAILY_LIMIT=20
MAIL_ENABLED=false
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 이 이메일의 소유권을 메일 인증한 뒤 재로그인하면 관리자 권한을 부여합니다.
ADMIN_EMAIL=
# prod 프로필에서만 필수입니다. JDBC URL을 사용합니다.
DATABASE_URL=jdbc:postgresql://localhost:5432/travelpick
DATABASE_USERNAME=travelpick
DATABASE_PASSWORD=
